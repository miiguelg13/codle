# Copia este fichero como server/.env y rellena los valores.

PORT=4000
MONGODB_URI=mongodb://localhost:27017/codle
# Cadena larga y aleatoria. Firma las cookies de sesión.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Zona horaria que marca el cambio de día
APP_TIMEZONE=Europe/Madrid
MAX_ATTEMPTS=5

# --- Ejecución de código -----------------------------------------------
# judge0 (recomendado) | local (SOLO desarrollo: ejecuta el código en tu PC sin aislamiento)
EXECUTOR=judge0

# Judge0 CE a través de RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
# Si usas una instancia propia con autenticación:
JUDGE0_AUTH_TOKEN=
# Opcional: forzar IDs de lenguaje (por defecto se detecta la versión más nueva)
# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_JAVASCRIPT=63
# JUDGE0_LANG_JAVA=62
# JUDGE0_LANG_CPP=54

# Comandos para EXECUTOR=local (en Windows suele ser "python" en lugar de "python3")
# LOCAL_PYTHON=python
# LOCAL_NODE=node
# LOCAL_JAVAC=javac
# LOCAL_JAVA=java
# LOCAL_GPP=g++
